# Environment secrets
.env
.env.*
!.env.example

# Common local artifacts
*.log
.DS_Store
Thumbs.db

# Node / React / TypeScript
node_modules/
dist/
.vite/
coverage/

# Python / FastAPI
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local SQLite databases (keep seed/source data in versioned text formats)
*.sqlite
*.sqlite3

# Model training artifacts (checkpoints, reports, logs);
# the deployed ONNX model is the exception — it ships with the repo.
backend/checkpoints/*
!backend/checkpoints/adder-onnx/
backend/checkpoints/adder-onnx/*
!backend/checkpoints/adder-onnx/adder.onnx
